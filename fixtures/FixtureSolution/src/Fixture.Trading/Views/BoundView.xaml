<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Fixture.Trading.Views"
             d:DataContext="{d:DesignInstance Type=vm:OrderViewModel}">
  <StackPanel>
    <TextBlock x:Uid="BoundView_Symbol" Text="{Binding Symbol}" Background="{StaticResource SurfaceBrush}" />
    <TextBlock Text="{Binding Volume, Mode=OneWay}" />
    <TextBlock Text="{Binding Symbl}" />
    <TextBlock Text="{Binding Selected.Symbol}" />
  </StackPanel>
</UserControl>
