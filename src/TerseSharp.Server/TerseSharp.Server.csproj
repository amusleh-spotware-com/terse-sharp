<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>terse</AssemblyName>
    <RootNamespace>TerseSharp.Server</RootNamespace>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>terse</ToolCommandName>
    <PackageId>TerseSharp</PackageId>
    <Description>Token-efficient Roslyn MCP server for C# and .NET. Navigate, read, edit and refactor a solution semantically instead of reading whole files.</Description>
    <PackageTags>mcp;roslyn;csharp;dotnet;code-navigation;refactoring;ai-agent</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/amusleh-spotware-com/terse-sharp</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <RollForward>latestMajor</RollForward>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TerseRidPackages)' == 'true'">
    <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64;any</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' == 'any'">false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/SKILL.md" LogicalName="TerseSharp.Server.Assets.SKILL.md" />
    <None Include="../../NUGET_README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="System.Management" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TerseSharp.Core/TerseSharp.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TerseSharp.UnitTests" />
    <InternalsVisibleTo Include="TerseSharp.E2ETests" />
  </ItemGroup>
</Project>
